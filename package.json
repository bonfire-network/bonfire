{
	"name": "project-bonfire",
	"license": "GPL-3.0-or-later",
	"private": true,
	"version": "0.0.1",
	"type": "module",
	"imports": {
		"#lib": "./src/lib/index.js",
		"#lib/*": "./src/lib/*"
	},
	"scripts": {
		"dev": "vite dev --host",
		"build": "vite build",
		"preview": "vite preview",
		"prepare": "svelte-kit sync && npm run build:theme-light && npm run build:theme-dark || echo ''",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
		"format": "prettier --write .",
		"lint": "prettier --check . && eslint .",
		"build:theme-light": "smui-theme compile static/smui.css -i src/theme",
		"build:theme-dark": "smui-theme compile static/smui-dark.css -i src/theme/dark",
		"deploy": "npm run build && gcloud app deploy --project openburn-471023 --version staging --no-promote build/app.yaml"
	},
	"dependencies": {
		"@supabase/ssr": "^0.12.7",
		"@supabase/supabase-js": "^2.119.0"
	},
	"devDependencies": {
		"@eslint/compat": "^2.1.1",
		"@eslint/js": "^10.0.1",
		"@material/typography": "^14.0.0",
		"@mdi/js": "^7.4.47",
		"@smui-extra/autocomplete": "^9.0.6",
		"@smui-extra/chip-input": "^9.0.6",
		"@smui/button": "^9.0.6",
		"@smui/checkbox": "^9.0.6",
		"@smui/chips": "^9.0.6",
		"@smui/data-table": "^9.0.6",
		"@smui/dialog": "^9.0.6",
		"@smui/fab": "^9.0.6",
		"@smui/form-field": "^9.0.6",
		"@smui/icon-button": "^9.0.6",
		"@smui/list": "^9.0.6",
		"@smui/paper": "^9.0.6",
		"@smui/radio": "^9.0.6",
		"@smui/segmented-button": "^9.0.6",
		"@smui/textfield": "^9.0.6",
		"@sveltejs/adapter-auto": "^8.0.1",
		"@sveltejs/kit": "^3.2.0",
		"@sveltejs/vite-plugin-svelte": "^7.3.1",
		"@types/node": "^26.6.6",
		"country-state-city": "^3.2.1",
		"eslint": "^10.14.0",
		"eslint-config-prettier": "^10.1.8",
		"eslint-plugin-svelte": "^3.24.1",
		"globals": "^17.14.0",
		"prettier": "^3.10.0",
		"prettier-plugin-svelte": "^4.1.1",
		"smui-theme": "^9.0.6",
		"svelte": "^5.57.3",
		"svelte-check": "^4.7.8",
		"svelte-i18n": "^4.0.1",
		"typescript": "^6",
		"typescript-eslint": "^8.72.2",
		"uuid": "^14.0.3",
		"vite": "^8.3.8",
		"vite-plugin-devtools-json": "^1.1.2"
	}
}